<%- include('../partials/header')%>
<div class="flex">
    <!-- Sidebar -->
  <%- include('../partials/sidebar')%>
<!-- Main Content -->

<div class="flex-1">

<!-- Navbar -->
<%- include('../partials/navbar')%>

<!-- resident content -->
 <div class="p-8">

    <!-- Page Header -->
    <div class="flex justify-between items-center mb-8">

        <div>
            <h1 class="text-3xl font-bold text-white">
                Residents Management
            </h1>

            <p class="text-zinc-400 mt-2">
                Manage all residents of your society.
            </p>
        </div>

        <a href="/admin/residents/add"
            class="bg-yellow-400 text-black px-6 py-3 rounded-lg font-semibold hover:bg-yellow-300 transition">

            + Add Resident

        </a>

    </div>

    <!-- Search & Filter -->

    <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-6 mb-8">

        <div class="grid md:grid-cols-3 gap-4">

            <input
                type="text"
                placeholder="Search Resident..."
                class="bg-black border border-zinc-700 rounded-lg px-4 py-3 outline-none focus:border-yellow-400">

            <select
                class="bg-black border border-zinc-700 rounded-lg px-4 py-3 outline-none focus:border-yellow-400">

                <option>All Blocks</option>
                <option>A Block</option>
                <option>B Block</option>
                <option>C Block</option>
                <option>D Block</option>

            </select>

            <button
                class="bg-yellow-400 text-black rounded-lg font-semibold hover:bg-yellow-300">

                Search

            </button>

        </div>

    </div>

    <!-- Residents Table -->

    <div class="bg-zinc-900 border border-zinc-800 rounded-xl overflow-hidden">

        <table class="w-full">

            <thead class="bg-zinc-800">

                <tr>

                    <th class="py-4 px-4 text-left">Photo</th>
                    <th class="text-left">Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Flat</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>

                </tr>

            </thead>

            <tbody>

    <% if (residents.length === 0) { %>

        <tr>
            <td colspan="7" class="text-center py-10 text-zinc-500">
                No residents found.
            </td>
        </tr>

    <% } %>


    <% residents.forEach(resident => { %>

        <tr class="border-b border-zinc-800 hover:bg-zinc-800">

            <td class="px-4 py-4">

                <img
                    src="<%= resident.profileImage || 'https://i.pravatar.cc/45' %>"
                    class="w-12 h-12 rounded-full">

            </td>

            <td>
                <%= resident.name %>
            </td>

            <td>
                <%= resident.email %>
            </td>

            <td>
                <%= resident.phone %>
            </td>

            <td>
                <%= resident.block %>-<%= resident.flat %>
            </td>

            <td>

                <% if (resident.status === "Active") { %>

                    <span class="bg-green-600 px-3 py-1 rounded-full text-sm">
                        Active
                    </span>

                <% } else { %>

                    <span class="bg-red-600 px-3 py-1 rounded-full text-sm">
                        Inactive
                    </span>

                <% } %>

            </td>

            <td>

                <div class="flex justify-center gap-2">

                    <a
                        href="/admin/residents/view/<%= resident._id %>"
                        class="bg-blue-600 px-3 py-2 rounded text-sm">

                        View

                    </a>

                    <a
                        href="/admin/residents/edit/<%= resident._id %>"
                        class="bg-yellow-400 text-black px-3 py-2 rounded text-sm">

                        Edit

                    </a>

                    <form
                        action="/admin/residents/delete/<%= resident._id %>"
                        method="POST"
                        onsubmit="return confirm('Are you sure you want to delete this resident?');">

                        <button
                            type="submit"
                            class="bg-red-600 px-3 py-2 rounded text-sm">

                            Delete

                        </button>

                    </form>

                </div>

            </td>

        </tr>

    <% }) %>

</tbody>

        </table>

    </div>

    <!-- Pagination -->

    <div class="flex justify-between items-center mt-8">

        <p class="text-zinc-400">
            Showing 1 to 2 of 50 Residents
        </p>

        <div class="flex gap-2">

            <button
                class="bg-zinc-800 px-4 py-2 rounded hover:bg-zinc-700">

                Previous

            </button>

            <button
                class="bg-yellow-400 text-black px-4 py-2 rounded">

                1

            </button>

            <button
                class="bg-zinc-800 px-4 py-2 rounded hover:bg-zinc-700">

                2

            </button>

            <button
                class="bg-zinc-800 px-4 py-2 rounded hover:bg-zinc-700">

                3

            </button>

            <button
                class="bg-zinc-800 px-4 py-2 rounded hover:bg-zinc-700">

                Next

            </button>

        </div>

    </div>

</div>

   </div> 
</div>
<%- include('../partials/footer')%>