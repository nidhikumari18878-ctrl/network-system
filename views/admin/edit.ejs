<%- include('../partials/header')%>
<div class="p-8">

    <!-- Page Header -->
    <div class="flex justify-between items-center mb-8">

        <div>
            <h1 class="text-3xl font-bold">
                Edit Resident
            </h1>

            <p class="text-zinc-400 mt-2">
                Update resident information.
            </p>
        </div>

        <a href="/admin/residents"
            class="bg-zinc-700 px-5 py-3 rounded-lg hover:bg-zinc-600">

            ← Back

        </a>

    </div>

    <!-- Form -->

    <form action="/admin/residents/update/<%= resident._id %>" method="POST" enctype="multipart/form-data">

        <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-8">

            <div class="grid md:grid-cols-2 gap-6">

                <!-- Profile Image -->

                <div class="md:col-span-2 text-center">

                    <img
                        src="<%= resident.profileImage %>"
                        class="w-28 h-28 rounded-full mx-auto border-4 border-yellow-400">

                    <input
                        type="file"
                        name="profileImage"
                        class="mt-5 w-full bg-black border border-zinc-700 rounded-lg p-3">

                </div>

                <!-- Name -->

                <div>

                    <label class="block mb-2">
                        Full Name
                    </label>

                    <input
                        type="text"
                        name="name"
                        value="<%= resident.name %>"
                        class="w-full bg-black border border-zinc-700 rounded-lg p-3 outline-none focus:border-yellow-400">

                </div>

                <!-- Email -->

                <div>

                    <label class="block mb-2">
                        Email
                    </label>

                    <input
                        type="email"
                        name="email"
                        value="<%= resident.email %>"
                        class="w-full bg-black border border-zinc-700 rounded-lg p-3">

                </div>

                <!-- Phone -->

                <div>

                    <label class="block mb-2">
                        Phone Number
                    </label>

                    <input
                        type="text"
                        name="phone"
                        value="<%= resident.phone %>"
                        class="w-full bg-black border border-zinc-700 rounded-lg p-3">

                </div>

                <!-- Gender -->

                <div>

                    <label class="block mb-2">
                        Gender
                    </label>

                    <select
                        name="gender"
                        class="w-full bg-black border border-zinc-700 rounded-lg p-3">

                        <option value="Male" <%= resident.gender=="Male" ? "selected" : "" %>>Male</option>

                        <option value="Female" <%= resident.gender=="Female" ? "selected" : "" %>>Female</option>

                        <option value="Other" <%= resident.gender=="Other" ? "selected" : "" %>>Other</option>

                    </select>

                </div>

                <!-- Flat -->

                <div>

                    <label class="block mb-2">
                        Flat Number
                    </label>

                    <input
                        type="text"
                        name="flat"
                        value="<%= resident.flat %>"
                        class="w-full bg-black border border-zinc-700 rounded-lg p-3">

                </div>

                <!-- Block -->

                <div>

                    <label class="block mb-2">
                        Block
                    </label>

                    <select
                        name="block"
                        class="w-full bg-black border border-zinc-700 rounded-lg p-3">

                        <option value="A">A</option>
                        <option value="B">B</option>
<%- include('../partials/footer')%>