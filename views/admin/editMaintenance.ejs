<%- include('../partials/header') %>

<div class="p-8 max-w-3xl mx-auto">

    <h1 class="text-3xl font-bold mb-6">
        Edit Maintenance
    </h1>

    <form
        action="/admin/maintenance/update/<%= record._id %>"
        method="POST"
        class="bg-zinc-900 border border-zinc-800 rounded-xl p-6 space-y-4"
    >

        <input
            type="text"
            name="residentName"
            value="<%= record.residentName %>"
            placeholder="Resident Name"
            required
            class="w-full bg-black border border-zinc-700 rounded-lg px-4 py-3"
        >

        <input
            type="text"
            name="flatNumber"
            value="<%= record.flatNumber %>"
            placeholder="Flat Number"
            required
            class="w-full bg-black border border-zinc-700 rounded-lg px-4 py-3"
        >

        <input
            type="text"
            name="block"
            value="<%= record.block %>"
            placeholder="Block"
            required
            class="w-full bg-black border border-zinc-700 rounded-lg px-4 py-3"
        >

        <input
            type="text"
            name="month"
            value="<%= record.month %>"
            placeholder="Month"
            required
            class="w-full bg-black border border-zinc-700 rounded-lg px-4 py-3"
        >

        <input
            type="number"
            name="amount"
            value="<%= record.amount %>"
            placeholder="Amount"
            min="0"
            required
            class="w-full bg-black border border-zinc-700 rounded-lg px-4 py-3"
        >

        <input
            type="date"
            name="dueDate"
            value="<%= record.dueDate ? new Date(record.dueDate).toISOString().slice(0, 10) : '' %>"
            required
            class="w-full bg-black border border-zinc-700 rounded-lg px-4 py-3"
        >

        <select
            name="status"
            class="w-full bg-black border border-zinc-700 rounded-lg px-4 py-3"
        >

            <option
                value="Pending"
                <%= record.status === "Pending" ? "selected" : "" %>
            >
                Pending
            </option>

            <option
                value="Paid"
                <%= record.status === "Paid" ? "selected" : "" %>
            >
                Paid
            </option>

            <option
                value="Overdue"
                <%= record.status === "Overdue" ? "selected" : "" %>
            >
                Overdue
            </option>

        </select>

        <div class="flex gap-3">

            <button
                type="submit"
                class="bg-yellow-400 text-black px-6 py-3 rounded-lg font-semibold"
            >
                Update Maintenance
            </button>

            <a
                href="/admin/maintenance"
                class="bg-zinc-700 px-6 py-3 rounded-lg"
            >
                Cancel
            </a>

        </div>

    </form>

</div>

<%- include('../partials/footer') %>