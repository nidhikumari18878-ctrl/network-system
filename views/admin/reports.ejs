<%- include('../partials/header')%>
<div class="p-8">

    <!-- Header -->

    <div class="flex justify-between items-center mb-8">

        <div>

            <h1 class="text-3xl font-bold">
                Reports & Analytics
            </h1>

            <p class="text-zinc-400 mt-2">
                View society reports and statistics.
            </p>

        </div>

        <button
            class="bg-yellow-400 text-black px-6 py-3 rounded-lg font-semibold hover:bg-yellow-300">

            Download Report

        </button>

    </div>

    <!-- Summary Cards -->

    <div class="grid md:grid-cols-4 gap-6">

        <div class="bg-zinc-900 rounded-xl p-6 border border-zinc-800">

            <h3 class="text-zinc-400">Residents</h3>

            <h1 class="text-4xl font-bold text-yellow-400 mt-2">
                250
            </h1>

        </div>

        <div class="bg-zinc-900 rounded-xl p-6 border border-zinc-800">

            <h3 class="text-zinc-400">Visitors</h3>

            <h1 class="text-4xl font-bold text-green-400 mt-2">
                65
            </h1>

        </div>

        <div class="bg-zinc-900 rounded-xl p-6 border border-zinc-800">

            <h3 class="text-zinc-400">Complaints</h3>

            <h1 class="text-4xl font-bold text-red-400 mt-2">
                18
            </h1>

        </div>

        <div class="bg-zinc-900 rounded-xl p-6 border border-zinc-800">

            <h3 class="text-zinc-400">Maintenance</h3>

            <h1 class="text-4xl font-bold text-blue-400 mt-2">
                ₹1,25,000
            </h1>

        </div>

    </div>

    <!-- Analytics -->

    <div class="bg-zinc-900 rounded-xl border border-zinc-800 p-6 mt-8">

        <h2 class="text-xl font-semibold mb-4">
            Monthly Analytics
        </h2>

        <div class="h-80 bg-zinc-800 rounded-lg flex items-center justify-center">

            <p class="text-zinc-500 text-lg">
                Chart.js Graph Here
            </p>

        </div>

    </div>

    <!-- Report Table -->

    <div class="bg-zinc-900 rounded-xl border border-zinc-800 mt-8 overflow-hidden">

        <table class="w-full">

            <thead class="bg-zinc-800">

                <tr>

                    <th class="py-4">Module</th>
                    <th>Total</th>
                    <th>Completed</th>
                    <th>Pending</th>

                </tr>

            </thead>

            <tbody>

                <tr class="border-b border-zinc-800 hover:bg-zinc-800">

                    <td class="py-4">Complaints</td>

                    <td>18</td>

                    <td class="text-green-400">12</td>

                    <td class="text-red-400">6</td>

                </tr>

                <tr class="border-b border-zinc-800 hover:bg-zinc-800">

                    <td class="py-4">Maintenance</td>

                    <td>250</td>

                    <td class="text-green-400">220</td>

                    <td class="text-yellow-400">30</td>

                </tr>

                <tr class="hover:bg-zinc-800">

                    <td class="py-4">Visitors</td>

                    <td>65</td>

                    <td class="text-green-400">60</td>

                    <td class="text-blue-400">5</td>

                </tr>

            </tbody>

        </table>

    </div>

</div>

<%- include('../partials/footer')%>