<%- include('../partials/header')%>

<div class="p-8">

    <!-- Page Header -->

    <div class="mb-8">

        <h1 class="text-3xl font-bold text-white">
            Add New Resident
        </h1>

        <p class="text-zinc-400 mt-2">
            Fill in the details to register a new resident.
        </p>

    </div>

    <!-- Form -->

    <form action="/admin/add" method="POST" enctype="multipart/form-data">

        <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-8">

            <div class="grid grid-cols-2 gap-6">

                <!-- Profile Image -->

                <div class="col-span-2">

                    <label class="block mb-2 font-medium">
                        Profile Image
                    </label>

                    <input
                        type="file"
                        name="profileImage"
                        class="w-full bg-black border border-zinc-700 rounded-lg p-3">

                </div>

                <!-- Name -->

                <div>

                    <label class="block mb-2">
                        Full Name
                    </label>

                    <input
                        type="text"
                        name="name"
                        placeholder="Enter Full Name"
                        class="w-full bg-black border border-zinc-700 rounded-lg p-3 outline-none focus:border-yellow-400">

                </div>

                <!-- Email -->

                <div>

                    <label class="block mb-2">
                        Email
                    </label>

                    <input
                        type="email"
                        name="email"
                        placeholder="Enter Email"
                        class="w-full bg-black border border-zinc-700 rounded-lg p-3 outline-none focus:border-yellow-400">

                </div>

                <!-- Phone -->

                <div>

                    <label class="block mb-2">
                        Phone Number
                    </label>

                    <input
                        type="text"
                        name="phone"
                        placeholder="9876543210"
                        class="w-full bg-black border border-zinc-700 rounded-lg p-3">

                </div>

                <!-- Gender -->

                <div>

                    <label class="block mb-2">
                        Gender
                    </label>

                    <select
                        name="gender"
                        class="w-full bg-black border border-zinc-700 rounded-lg p-3">

                        <option>Select Gender</option>
                        <option>Male</option>
                        <option>Female</option>
                        <option>Other</option>

                    </select>

                </div>

                <!-- Flat Number -->

                <div>

                    <label class="block mb-2">
                        Flat Number
                    </label>

                    <input
                        type="text"
                        name="flat"
                        placeholder="A-101"
                        class="w-full bg-black border border-zinc-700 rounded-lg p-3">

                </div>

                <!-- Block -->

                <div>

                    <label class="block mb-2">
                        Block
                    </label>

                    <select
                        name="block"
                        class="w-full bg-black border border-zinc-700 rounded-lg p-3">

                        <option>Select Block</option>
                        <option>A</option>
                        <option>B</option>
                        <option>C</option>
                        <option>D</option>

                    </select>

                </div>

                <!-- Family Members -->

                <div>

                    <label class="block mb-2">
                        Family Members
                    </label>

                    <input
                        type="number"
                        name="members"
                        placeholder="4"
                        class="w-full bg-black border border-zinc-700 rounded-lg p-3">

                </div>

                <!-- Occupation -->

                <div>

                    <label class="block mb-2">
                        Occupation
                    </label>

                    <input
                        type="text"
                        name="occupation"
                        placeholder="Software Engineer"
                        class="w-full bg-black border border-zinc-700 rounded-lg p-3">

                </div>

                <!-- Password -->

                <div>

                    <label class="block mb-2">
                        Password
                    </label>

                    <input
                        type="password"
                        name="password"
                        placeholder="********"
                        class="w-full bg-black border border-zinc-700 rounded-lg p-3">

                </div>

                <!-- Confirm Password -->

                <div>

                    <label class="block mb-2">
                        Confirm Password
                    </label>

                    <input
                        type="password"
                        name="confirmPassword"
                        placeholder="********"
                        class="w-full bg-black border border-zinc-700 rounded-lg p-3">

                </div>

            </div>

            <!-- Buttons -->

            <div class="flex justify-end gap-4 mt-8">

                <a href="/admin/residents"
                    class="bg-zinc-700 px-6 py-3 rounded-lg hover:bg-zinc-600">

                    Cancel

                </a>

                <button
                    type="submit"
                    class="bg-yellow-400 text-black px-8 py-3 rounded-lg font-semibold hover:bg-yellow-300">

                    Save Resident

                </button>

            </div>

        </div>

    </form>

</div>
<%- include('../partials/footer')%>